# Copy to .env for local (non-docker) runs. docker-compose sets these itself.

# --- Postgres (superuser, used only by bootstrap to create schema/roles/RLS) ---
ADMIN_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/acp

# --- App role: RLS ENFORCED. Used by authz/expense/payroll (tenant-scoped). ---
APP_DATABASE_URL=postgresql+psycopg2://app_user:app_pass@localhost:5432/acp
APP_DB_PASSWORD=app_pass

# --- Identity role: BYPASSRLS. Used ONLY by the Auth service (identity authority,
#     operates above tenant scope to manage global users + cross-tenant memberships). ---
IDENTITY_DATABASE_URL=postgresql+psycopg2://identity_user:identity_pass@localhost:5432/acp
IDENTITY_DB_PASSWORD=identity_pass

# --- Redis (decision cache + refresh sessions) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET=dev-secret-change-me
SERVICE_JWT_SECRET=dev-service-secret-change-me
ACCESS_TTL_SECONDS=900
IDENTITY_TTL_SECONDS=600
REFRESH_TTL_SECONDS=604800

# --- Authorization ---
DECISION_CACHE_TTL=15

# --- Service discovery ---
AUTH_URL=http://localhost:8001
AUTHZ_URL=http://localhost:8002
EXPENSE_URL=http://localhost:8003
PAYROLL_URL=http://localhost:8004
